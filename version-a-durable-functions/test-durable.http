POST http://localhost:7071/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "test@example.com",
  "amount": 50,
  "category": "meals",
  "description": "Team lunch",
  "managerEmail": "manager@example.com"
}

