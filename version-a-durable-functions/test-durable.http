@baseUrl = http://localhost:7071

### =====================================================
### Scenario 1 - Valid expense under $100
### Expected: Auto-approved
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "employee@example.com",
  "amount": 50,
  "category": "meals",
  "description": "Team lunch",
  "managerEmail": "manager@example.com"
}


### =====================================================
### Scenario 2 - Expense >= $100, manager approves
### Expected: Approved
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "employee@example.com",
  "amount": 250,
  "category": "equipment",
  "description": "New monitor",
  "managerEmail": "manager@example.com"
}

### After starting the workflow:
### Copy the returned instance ID and replace INSTANCE_ID below.

POST {{baseUrl}}/api/expenses/22509d87f10f46169d7d8fb440d91467/decision
Content-Type: application/json

{
  "decision": "approve"
}


### =====================================================
### Scenario 3 - Expense >= $100, manager rejects
### Expected: Rejected
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "employee@example.com",
  "amount": 250,
  "category": "software",
  "description": "Software license",
  "managerEmail": "manager@example.com"
}

### Replace INSTANCE_ID with the ID returned above.

POST {{baseUrl}}/api/expenses/a45bf40f480c4389a755a67eb3eae24c/decision
Content-Type: application/json

{
  "decision": "reject"
}


### =====================================================
### Scenario 4 - Expense >= $100, no manager response
### Expected: Escalated after timeout
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "employee@example.com",
  "amount": 400,
  "category": "travel",
  "description": "Conference travel",
  "managerEmail": "manager@example.com"
}

### Do NOT send a manager decision.
### Wait for the configured timeout.
### Then check the statusQueryGetUri.
### Expected final status: escalated


### =====================================================
### Scenario 5 - Missing required field
### Expected: Validation error
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "amount": 50,
  "category": "meals",
  "description": "Team lunch",
  "managerEmail": "manager@example.com"
}


### =====================================================
### Scenario 6 - Invalid category
### Expected: Validation error
### =====================================================

POST {{baseUrl}}/api/expenses/start
Content-Type: application/json

{
  "employeeName": "Jingjing Duan",
  "employeeEmail": "employee@example.com",
  "amount": 75,
  "category": "gaming",
  "description": "Invalid category test",
  "managerEmail": "manager@example.com"
}